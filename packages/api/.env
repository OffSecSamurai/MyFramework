# Database Configuration
DATABASE_URL="file:./storage/database.sqlite"

# Redis Configuration
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# API Configuration
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# Web Configuration
WEB_PORT=3000
VITE_API_URL=http://localhost:3001

# Worker Configuration
WORKER_THREADS=50
WORKER_TIMEOUT=300000
WORKER_CONCURRENCY=5

# Storage Configuration
STORAGE_PATH="./storage"
ARTIFACTS_PATH="./storage/artifacts"
REPORTS_PATH="./storage/reports"

# Tool Configuration (Docker by default, set to 'native' for Kali VM tools)
EXECUTION_MODE=docker

# Native Tool Paths (for Kali VM integration)
SUBFINDER_PATH="/usr/local/bin/subfinder"
ASSETFINDER_PATH="/usr/local/bin/assetfinder"
FINDOMAIN_PATH="/usr/local/bin/findomain"
CHAOS_PATH="/usr/local/bin/chaos"
AMASS_PATH="/usr/local/bin/amass"
DNSX_PATH="/usr/local/bin/dnsx"
HTTPX_PATH="/usr/local/bin/httpx"
AQUATONE_PATH="/usr/local/bin/aquatone"
GAU_PATH="/usr/local/bin/gau"
WAYBACKURLS_PATH="/usr/local/bin/waybackurls"
KATANA_PATH="/usr/local/bin/katana"
ARJUN_PATH="/usr/local/bin/arjun"
GOBUSTER_PATH="/usr/local/bin/gobuster"
FFUF_PATH="/usr/local/bin/ffuf"
NUCLEI_PATH="/usr/local/bin/nuclei"
NIKTO_PATH="/usr/local/bin/nikto"

# API Keys (optional)
CHAOS_API_KEY=""
GITHUB_TOKEN=""
SHODAN_API_KEY=""

# Proxy Configuration (for Burp Suite integration)
HTTP_PROXY=""
HTTPS_PROXY=""
NO_PROXY="localhost,127.0.0.1"

# Security Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
SESSION_SECRET="your-session-secret-key-change-this-in-production"
CORS_ORIGIN="http://localhost:3000"

# Logging Configuration
LOG_LEVEL="info"
LOG_FILE="./storage/logs/akshays_framework.log"

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket Configuration
WS_PORT=3002
WS_HOST=0.0.0.0