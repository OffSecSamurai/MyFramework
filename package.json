{
  "name": "akshays-framework",
  "version": "1.0.0",
  "description": "A comprehensive reconnaissance and vulnerability testing framework",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd packages/api && npm run dev",
    "dev:web": "cd packages/web && npm run dev",
    "build": "npm run build:api && npm run build:web && npm run build:worker",
    "build:api": "cd packages/api && npm run build",
    "build:web": "cd packages/web && npm run build",
    "build:worker": "cd packages/worker && npm run build",
    "start": "docker-compose up -d",
    "stop": "docker-compose down",
    "setup": "npm install && npm run build && npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:reset": "npx prisma migrate reset",
    "db:studio": "npx prisma studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^5.7.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}