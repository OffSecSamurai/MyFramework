# Copy to .env and adjust as needed
# Service Ports
WEB_PORT=3000
API_PORT=4000

# Redis / BullMQ
REDIS_URL=redis://redis:6379

# Prisma SQLite
DATABASE_URL=file:./dev.db

# Execution defaults
MAX_THREADS=50
STORAGE_ROOT=/app/storage

# Socket.IO
SOCKET_PATH=/socket.io

# Native execution (optional): set to enable Kali VM execution over SSH
NATIVE_SSH_HOST=
NATIVE_SSH_USER=
NATIVE_SSH_KEY_PATH=/app/.ssh/id_rsa

# Project metadata
APP_NAME=Akshays Framework
NODE_ENV=production