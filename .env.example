# =============================================================================
# AKSHAY'S FRAMEWORK - ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1

# -----------------------------------------------------------------------------
# API SERVER CONFIGURATION  
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
API_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION (BullMQ)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# WORKER CONFIGURATION
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=5
MAX_THREADS=50
WORKER_TIMEOUT=3600000
JOB_ATTEMPTS=3
JOB_BACKOFF=exponential

# -----------------------------------------------------------------------------
# STORAGE CONFIGURATION
# -----------------------------------------------------------------------------
STORAGE_PATH=./storage
ARTIFACTS_PATH=./storage/artifacts
REPORTS_PATH=./storage/reports
TEMP_PATH=./storage/temp

# -----------------------------------------------------------------------------
# TOOL CONFIGURATION
# -----------------------------------------------------------------------------
# Tool execution preferences
USE_NATIVE_TOOLS=true
DOCKER_FALLBACK=true
TOOL_TIMEOUT=1800

# Docker configuration
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_REGISTRY=

# -----------------------------------------------------------------------------
# PROXY CONFIGURATION
# -----------------------------------------------------------------------------
# Burp Suite Integration
BURP_PROXY_HOST=
BURP_PROXY_PORT=8080
BURP_PROXY_ENABLED=false

# OWASP ZAP Integration  
ZAP_PROXY_HOST=
ZAP_PROXY_PORT=8081
ZAP_PROXY_ENABLED=false

# -----------------------------------------------------------------------------
# VM INTEGRATION PATHS
# -----------------------------------------------------------------------------
# Kali VM paths (adjust to your setup)
KALI_VM_MOUNT_PATH=/mnt/shared
KALI_TOOLS_PATH=/usr/bin

# Windows VM paths
WINDOWS_VM_BURP_PATH=C:\\Program Files\\BurpSuitePro
WINDOWS_VM_FIREFOX_PATH=C:\\Program Files\\Mozilla Firefox

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session configuration
SESSION_SECRET=your-session-secret-change-this
SESSION_MAX_AGE=86400000

# API Keys (add your keys here)
CHAOS_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# -----------------------------------------------------------------------------
# NOTIFICATION CONFIGURATION (Optional)
# -----------------------------------------------------------------------------
# Slack notifications
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#security

# Email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@akshaysframework.com

# -----------------------------------------------------------------------------
# DEVELOPMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Development mode settings
DEBUG_MODE=false
VERBOSE_LOGGING=false
HOT_RELOAD=true

# Performance monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# -----------------------------------------------------------------------------
# PRODUCTION OVERRIDES
# -----------------------------------------------------------------------------
# Uncomment and modify for production deployment
# NODE_ENV=production
# API_HOST=0.0.0.0
# CORS_ORIGIN=https://your-domain.com
# DATABASE_URL=postgresql://user:pass@host:5432/akshays_framework
# REDIS_URL=redis://your-redis-host:6379

# -----------------------------------------------------------------------------
# HARDWARE OPTIMIZATION
# -----------------------------------------------------------------------------
# CPU/Memory limits for your Intel Core i5 12th Gen, 16GB DDR4 setup
MAX_CPU_CORES=8
MAX_MEMORY_MB=12288
CONCURRENT_SCANS=3
BATCH_SIZE=1000

# SSD optimization
ENABLE_SSD_OPTIMIZATION=true
TEMP_CLEANUP_INTERVAL=3600

# GPU acceleration (if available)
ENABLE_GPU_ACCELERATION=false
CUDA_VISIBLE_DEVICES=0