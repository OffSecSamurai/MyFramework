// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Target {
  id          String   @id @default(cuid())
  domain      String   @unique
  name        String?
  description String?
  scope       String? // JSON string for scope configuration
  status      String   @default("ACTIVE") // TargetStatus
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  executions      Execution[]
  artifacts       Artifact[]
  vulnerabilities Vulnerability[]

  @@map("targets")
}

model Execution {
  id          String    @id @default(cuid())
  targetId    String
  mode        String // ExecutionMode
  status      String    @default("PENDING") // ExecutionStatus
  progress    Int       @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  metadata    String? // JSON string for additional data
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  target    Target     @relation(fields: [targetId], references: [id], onDelete: Cascade)
  tasks     Task[]
  artifacts Artifact[]

  @@map("executions")
}

model Task {
  id          String    @id @default(cuid())
  executionId String
  tool        String
  status      String    @default("PENDING") // TaskStatus
  startedAt   DateTime?
  completedAt DateTime?
  output      String?
  error       String?
  metadata    String? // JSON string for additional data
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model Artifact {
  id          String   @id @default(cuid())
  targetId    String
  executionId String?
  name        String
  type        String // ArtifactType
  path        String
  size        Int
  mimeType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  target    Target     @relation(fields: [targetId], references: [id], onDelete: Cascade)
  execution Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@map("artifacts")
}

model Vulnerability {
  id          String   @id @default(cuid())
  targetId    String
  tool        String
  type        String
  severity    String // VulnerabilitySeverity
  title       String
  description String?
  evidence    String? // JSON string for evidence data
  cve         String?
  cwe         String?
  cvss        Float?
  status      String   @default("NEW") // VulnerabilityStatus
  metadata    String? // JSON string for additional data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@map("vulnerabilities")
}

model Report {
  id          String   @id @default(cuid())
  targetId    String
  executionId String?
  type        String // ReportType
  format      String // ReportFormat
  content     String?
  path        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reports")
}
